{% extends '@Git/layout.html.twig' %}

{% block title %}{{ commit.shortSha }}: {{ commit.subject }} — {{ config.label ?? repo }}{% endblock %}

{% block body %}
{{ include('@Git/_repo_nav.html.twig') }}

<div class="commit-header">
    <h2>{{ commit.subject }}</h2>

    {% set body = commit.message|slice(commit.subject|length)|trim %}
    {% if body %}
        <pre class="commit-body">{{ body }}</pre>
    {% endif %}

    <div style="display:flex; gap:24px; margin-top:12px; font-size:13px; color:#57606a;">
        <span>
            <strong style="color:#24292f;">{{ commit.authorName }}</strong>
            authored {{ commit.authorDate|date('Y-m-d H:i') }}
        </span>
        {% if commit.committerName != commit.authorName %}
        <span>
            <strong style="color:#24292f;">{{ commit.committerName }}</strong>
            committed {{ commit.committerDate|date('Y-m-d H:i') }}
        </span>
        {% endif %}
        <span style="margin-left:auto; font-family:monospace; color:#57606a;">{{ commit.sha }}</span>
    </div>

    {% if commit.stats %}
    <div class="commit-stats" style="margin-top:12px;">
        <span class="commit-stat">{{ commit.stats.files_changed }} file{{ commit.stats.files_changed != 1 ? 's' : '' }} changed</span>
        {% if commit.stats.insertions > 0 %}
            <span class="commit-stat"><span class="add">+{{ commit.stats.insertions }}</span></span>
        {% endif %}
        {% if commit.stats.deletions > 0 %}
            <span class="commit-stat"><span class="del">-{{ commit.stats.deletions }}</span></span>
        {% endif %}
    </div>
    {% endif %}

    {% if commit.parentShas %}
    <div style="margin-top:8px; font-size:12px; color:#57606a;">
        Parents:
        {% for parent in commit.parentShas %}
            <a href="{{ path('git_commit', {repo: repo, sha: parent}) }}" style="font-family:monospace;">{{ parent|slice(0,8) }}</a>
        {% endfor %}
    </div>
    {% endif %}
</div>

{% if commit.diff %}
    {{ include('@Git/_diff.html.twig', {raw_diff: commit.diff}) }}
{% else %}
    <div class="alert alert-info">No diff available (initial commit or empty).</div>
{% endif %}
{% endblock %}
